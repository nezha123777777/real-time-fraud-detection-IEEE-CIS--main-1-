# Copy this file to .env and fill in actual values.
# The pipeline reads these via python-dotenv.

# Override the project root if the repo is not the working directory
# PROJECT_ROOT=c:\Users\User\Documents\pfa\ieee_fraud_project

# MLflow
# MLFLOW_TRACKING_URI=http://localhost:5050
# MLFLOW_EXPERIMENT_NAME=ieee-fraud-detection
# MLFLOW_RUN_NAME=xgboost_smote_onnx

# Streaming / serving
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TX_TOPIC=fraud_transactions
KAFKA_PRED_TOPIC=fraud_predictions
KAFKA_DLQ_TOPIC=fraud_dlq
FRAUD_API_URL=http://localhost:8000
FRAUD_API_RETRIES=3
FRAUD_API_TIMEOUT_SECONDS=2.0
FRAUD_THRESHOLD=0.50
FRAUD_REVIEW_THRESHOLD=0.35

# PostgreSQL storage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=frauddb
POSTGRES_USER=frauduser
POSTGRES_PASSWORD=fraudpass
